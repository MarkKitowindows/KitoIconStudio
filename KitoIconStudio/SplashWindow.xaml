<Window x:Class="KitoIconStudio.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kito Icon Studio" Width="720" Height="406" WindowStyle="None"
        ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False" FontFamily="Segoe UI">
    <Border Background="#151B2B" BorderBrush="#36405B" BorderThickness="1" CornerRadius="18">
        <Border.Effect>
            <DropShadowEffect ShadowDepth="12" BlurRadius="32" Opacity="0.55"/>
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="295"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" CornerRadius="17,0,0,17">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#5834BC" Offset="0"/>
                        <GradientStop Color="#7654ED" Offset="0.62"/>
                        <GradientStop Color="#263884" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid ClipToBounds="True">
                    <Ellipse Width="340" Height="340" Margin="-140,-150,0,0" Fill="#17FFFFFF"
                             HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Ellipse Width="340" Height="340" Margin="0,0,-150,-180" Fill="#2949F5DD"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                    <Border Width="175" Height="175" CornerRadius="38" Background="#F7F9FF"
                            RenderTransformOrigin=".5,.5">
                        <Border.RenderTransform><RotateTransform Angle="-12"/></Border.RenderTransform>
                        <Grid>
                            <Border Margin="18" Background="#D6C5FF" CornerRadius="27"/>
                            <Path Data="M 16,81 L 63,35 L 90,65 L 123,17" Stroke="#5B38C3"
                                  StrokeThickness="13" StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stretch="Uniform" Margin="27,30,26,28"/>
                            <Ellipse Width="22" Height="22" Fill="#27BDAF" Margin="0,0,31,30"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="40,33,37,29">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <TextBlock Text="KITO CORPORATION" Foreground="#B7A4FF" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Text="Kito Icon" Foreground="White" FontSize="41" FontWeight="Bold" Margin="0,28,0,0"/>
                    <TextBlock Text="Studio" Foreground="White" FontSize="41" FontWeight="Bold" Margin="0,-10,0,0"/>
                    <Border Width="73" Height="4" Background="#9B82FF" CornerRadius="2"
                            HorizontalAlignment="Left" Margin="0,17,0,0"/>
                    <TextBlock Text="Create something iconic." Foreground="#BEC6DA"
                               FontSize="14" Margin="0,20,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Preparing your workspace..." Foreground="#B9C3DC" FontSize="12" Margin="0,0,0,13"/>
                    <Border Background="#313A52" Height="5" CornerRadius="3" ClipToBounds="True">
                        <Grid>
                            <Border Background="#A18BFF" HorizontalAlignment="Left" Width="290" CornerRadius="3">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ProgressShift" X="-290"/>
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </Border>
                    <Grid Margin="0,17,0,0">
                        <TextBlock Text="© Kito Corporation" Foreground="#7F8BA5" FontSize="11"/>
                        <TextBlock Text="v0.2 Beta" Foreground="#B5A6FF" HorizontalAlignment="Right" FontSize="11"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
