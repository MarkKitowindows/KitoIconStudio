<Window x:Class="KitoIconStudio.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор цвета"
        Width="640" Height="550" MinWidth="620" MinHeight="530"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#101728" Foreground="#F6F7FF" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="BoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#0B1324"/>
            <Setter Property="BorderBrush" Value="#36435F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="SelectionBrush" Value="#8365E9"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#7657E8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="18,11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}" x:Name="Outer">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Opacity" Value="0.82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26,21,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,19">
            <TextBlock x:Name="HeadingText" Text="Выбор цвета" FontSize="23" FontWeight="Bold" Foreground="White"/>
            <TextBlock x:Name="HintText" Text="Нажми на квадрат и выбери оттенок"
                       Foreground="#AEB9D4" FontSize="12" Margin="0,4,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="17"/>
                <ColumnDefinition Width="29"/>
                <ColumnDefinition Width="22"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Photoshop-inspired: horizontal saturation and vertical brightness -->
            <Grid Grid.Column="0" x:Name="SaturationArea" Width="300" Height="300"
                  HorizontalAlignment="Left" VerticalAlignment="Top"
                  Cursor="Cross" ClipToBounds="True"
                  MouseLeftButtonDown="SaturationArea_MouseLeftButtonDown"
                  MouseLeftButtonUp="SaturationArea_MouseLeftButtonUp"
                  MouseMove="SaturationArea_MouseMove" LostMouseCapture="SaturationArea_LostMouseCapture">
                <Border x:Name="HueBase" Background="Red"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SaturationMarker" Width="16" Height="16"
                             Stroke="White" StrokeThickness="2"
                             Fill="Transparent">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="4" Opacity="0.8"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <Grid Grid.Column="2" x:Name="HueArea" Width="29" Height="300"
                  VerticalAlignment="Top" Cursor="Hand" ClipToBounds="False"
                  MouseLeftButtonDown="HueArea_MouseLeftButtonDown"
                  MouseLeftButtonUp="HueArea_MouseLeftButtonUp"
                  MouseMove="HueArea_MouseMove" LostMouseCapture="HueArea_LostMouseCapture">
                <Border Margin="3,0" CornerRadius="2">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FFFF0000" Offset="0"/>
                            <GradientStop Color="#FFFFFF00" Offset="0.16667"/>
                            <GradientStop Color="#FF00FF00" Offset="0.33333"/>
                            <GradientStop Color="#FF00FFFF" Offset="0.5"/>
                            <GradientStop Color="#FF0000FF" Offset="0.66667"/>
                            <GradientStop Color="#FFFF00FF" Offset="0.83333"/>
                            <GradientStop Color="#FFFF0000" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueMarker" Width="29" Height="9" Background="Transparent"
                            BorderBrush="White" BorderThickness="2" CornerRadius="2"/>
                </Canvas>
            </Grid>

            <StackPanel Grid.Column="4">
                <Grid Height="78">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="OldColorPreview" Grid.Column="0" CornerRadius="10"/>
                    <Border x:Name="NewColorPreview" Grid.Column="2" CornerRadius="10"/>
                </Grid>
                <Grid Margin="0,7,0,19">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="OriginalText" Text="Было" Foreground="#A5B1CB" HorizontalAlignment="Center" FontSize="11"/>
                    <TextBlock Grid.Column="2" x:Name="NewText" Text="Стало" Foreground="#A5B1CB" HorizontalAlignment="Center" FontSize="11"/>
                </Grid>
                <TextBlock Text="HEX" Foreground="#B7C2DB" FontSize="11" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="HexInput" Style="{StaticResource BoxStyle}" KeyDown="HexInput_KeyDown"/>
                <TextBlock Text="RGB" Foreground="#B7C2DB" FontSize="11" FontWeight="Bold" Margin="0,16,0,7"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="7"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RInput" Grid.Column="0" Style="{StaticResource BoxStyle}"/>
                    <TextBox x:Name="GInput" Grid.Column="2" Style="{StaticResource BoxStyle}"/>
                    <TextBox x:Name="BInput" Grid.Column="4" Style="{StaticResource BoxStyle}"/>
                </Grid>
                <Button x:Name="ApplyValuesText" Content="Применить значения" Style="{StaticResource ActionButton}"
                        Background="#293853" Margin="0,12,0,0" Click="ApplyValues_Click"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ValidationText" Grid.Column="0" Text="Выбирай оттенок мышкой или введи HEX/RGB."
                       Foreground="#9FABCA" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Grid.Column="1" x:Name="CancelText" Content="Отмена" Background="#293853"
                    Style="{StaticResource ActionButton}" Click="Cancel_Click"/>
            <Button Grid.Column="3" x:Name="ConfirmText" Content="Выбрать" MinWidth="120"
                    Style="{StaticResource ActionButton}" Click="Confirm_Click"/>
        </Grid>
    </Grid>
</Window>
