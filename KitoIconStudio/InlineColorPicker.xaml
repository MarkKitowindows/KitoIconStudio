<UserControl x:Class="KitoIconStudio.InlineColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="198" Height="205" FontFamily="Segoe UI">
    <Grid Margin="0,0,0,0" ClipToBounds="False">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="22"/>
        </Grid.ColumnDefinitions>
        <!-- A Photoshop-style saturation/brightness color field -->
        <Border Grid.Column="0" Background="#101828" BorderBrush="#52617B"
                BorderThickness="1" CornerRadius="4" ClipToBounds="True">
            <Grid x:Name="SaturationArea" Cursor="Cross"
                  SizeChanged="ColorFields_SizeChanged"
                  MouseLeftButtonDown="Saturation_MouseLeftButtonDown"
                  MouseLeftButtonUp="Saturation_MouseLeftButtonUp"
                  LostMouseCapture="Saturation_LostMouseCapture"
                  MouseMove="Saturation_MouseMove">
                <Rectangle x:Name="HueColorBackground" Fill="Red"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0"/>
                            <GradientStop Color="#FF000000" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="SaturationMarker" Width="15" Height="15"
                             Stroke="White" StrokeThickness="2" Fill="Transparent">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="Black" ShadowDepth="0" BlurRadius="3" Opacity="0.9"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>
        <!-- Vertical hue strip -->
        <Border Grid.Column="2" Background="#111827" CornerRadius="4" ClipToBounds="True"
                BorderThickness="1" BorderBrush="#52617B">
            <Grid x:Name="HueArea" Cursor="Hand" SizeChanged="ColorFields_SizeChanged"
                  MouseLeftButtonDown="Hue_MouseLeftButtonDown"
                  MouseLeftButtonUp="Hue_MouseLeftButtonUp"
                  MouseMove="Hue_MouseMove"
                  LostMouseCapture="Hue_LostMouseCapture">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="Red" Offset="0"/>
                            <GradientStop Color="Yellow" Offset="0.166667"/>
                            <GradientStop Color="Lime" Offset="0.333333"/>
                            <GradientStop Color="Cyan" Offset="0.5"/>
                            <GradientStop Color="Blue" Offset="0.666667"/>
                            <GradientStop Color="Magenta" Offset="0.833333"/>
                            <GradientStop Color="Red" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueMarker" Height="7" BorderBrush="White"
                            BorderThickness="2" Background="Transparent"/>
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</UserControl>
