<Window x:Class="KitoIconStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KitoIconStudio"
        Title="Kito Icon Studio" Width="1360" Height="860" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#0B101C" Foreground="#EAF0FF"
        FontFamily="Segoe UI" Closing="MainWindow_Closing"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="Edge" Color="#29354D"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A8B5CF"/>
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="#151D2E"/>
            <Setter Property="BorderBrush" Value="{StaticResource Edge}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="13"/>
        </Style>
        <Style x:Key="CommandButton" TargetType="Button">
            <Setter Property="Background" Value="#253149"/>
            <Setter Property="Foreground" Value="#E8EEFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Face" Background="{TemplateBinding Background}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.78"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Face" Property="Opacity" Value="0.55"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Face" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Background" Value="#6C50DA"/>
        </Style>
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Width" Value="88"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#1D273B"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="ToolButtonLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF0FF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource CommandButton}">
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
        </Style>
        <Style x:Key="PaletteCell" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#66748C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PaletteFace" Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}" CornerRadius="6"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PaletteFace" Property="Opacity" Value="0.80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#10182B"/>
            <Setter Property="BorderBrush" Value="#354660"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,24,24"
                      ViewportUnits="Absolute" Viewbox="0,0,24,24" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#F1F3F8" Geometry="M 0,0 L24,0 24,24 0,24 Z"/>
                    <GeometryDrawing Brush="#D5DAE3" Geometry="M 0,0 L12,0 12,12 0,12 Z"/>
                    <GeometryDrawing Brush="#D5DAE3" Geometry="M 12,12 L24,12 24,24 12,24 Z"/>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#182236"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#EAF0FF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#6C50DA"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#6C50DA"/>
        <Style TargetType="Menu">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E6ECFC"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#EAF0FF"/>
            <Setter Property="Background" Value="#1B263A"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#6C50DA"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True">
                    <Setter Property="Background" Value="#243149"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#7282A0"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="61"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="29"/>
        </Grid.RowDefinitions>

        <!-- Branded menu/title strip -->
        <Border Grid.Row="0" Background="#131A2B" BorderBrush="#2A3550" BorderThickness="0,0,0,1">
            <Grid Margin="18,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="30" Height="30" CornerRadius="9" Background="#7254DE"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <Path Data="M 4,21 L 12,8 L 18,15 L 26,5" Stroke="White" StrokeThickness="3.2"
                          Stretch="Uniform" Margin="6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,25,0">
                    <TextBlock Text="KITO ICON STUDIO" FontSize="14" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="VersionCaption" Text="BETA 0.2.3" FontSize="9" FontWeight="SemiBold" Foreground="#9B8DFB"/>
                </StackPanel>
                <Menu Grid.Column="2" VerticalAlignment="Center" Background="Transparent">
                    <MenuItem x:Name="FileMenu" Header="Файл">
                        <MenuItem x:Name="MenuNew" Header="Создать..." Click="New_Click" InputGestureText="Ctrl+N"/>
                        <MenuItem x:Name="MenuOpen" Header="Открыть проект..." Click="Open_Click" InputGestureText="Ctrl+O"/>
                        <MenuItem x:Name="MenuSave" Header="Сохранить проект" Click="Save_Click" InputGestureText="Ctrl+S"/>
                        <Separator/>
                        <MenuItem x:Name="MenuImport" Header="Импорт изображения..." Click="Import_Click"/>
                        <MenuItem x:Name="MenuPng" Header="Экспорт PNG..." Click="ExportPng_Click"/>
                        <MenuItem x:Name="MenuIco" Header="Экспорт ICO..." Click="ExportIco_Click"/>
                        <Separator/>
                        <MenuItem x:Name="MenuExit" Header="Выход" Click="Exit_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="EditMenu" Header="Правка">
                        <MenuItem x:Name="MenuUndo" Header="Отменить" Click="Undo_Click" InputGestureText="Ctrl+Z"/>
                        <MenuItem x:Name="MenuRedo" Header="Повторить" Click="Redo_Click" InputGestureText="Ctrl+Y"/>
                        <Separator/>
                        <MenuItem x:Name="MenuClear" Header="Очистить слой" Click="ClearLayer_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="ViewMenu" Header="Вид">
                        <MenuItem x:Name="MenuRussian" Header="Русский" Click="Russian_Click" IsCheckable="True" IsChecked="True"/>
                        <MenuItem x:Name="MenuEnglish" Header="English" Click="English_Click" IsCheckable="True"/>
                    </MenuItem>
                    <MenuItem x:Name="HelpMenu" Header="Справка">
                        <MenuItem x:Name="MenuAbout" Header="О программе" Click="About_Click"/>
                    </MenuItem>
                </Menu>
                <TextBlock Grid.Column="3" Text="KITO CORPORATION" Foreground="#7786A7"
                           VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Quick commands -->
        <Border Grid.Row="1" Background="#111929" BorderBrush="#24324A" BorderThickness="0,0,0,1">
            <Grid Margin="21,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewBtn" Style="{StaticResource CommandButton}" Click="New_Click" Margin="0,0,9,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 4,3 L17,3 L22,8 L22,24 L4,24 Z M17,3 L17,8 L22,8"
                                  Stroke="#B7A8FF" StrokeThickness="2" Width="17" Height="18" Stretch="Uniform"/>
                            <TextBlock x:Name="NewText" Text="Создать" Margin="9,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="OpenBtn" Style="{StaticResource CommandButton}" Click="Open_Click" Margin="0,0,9,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 2,8 L2,20 L22,20 L22,8 L13,8 L10,5 L2,5 Z" Stroke="#A6E4E2"
                                  StrokeThickness="2" Width="19" Height="17" Stretch="Uniform"/>
                            <TextBlock x:Name="OpenText" Text="Открыть" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveBtn" Style="{StaticResource CommandButton}" Click="Save_Click" Margin="0,0,9,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 4,2 L19,2 L23,7 L23,24 L4,24 Z M8,2 L8,9 L18,9 L18,2 M8,24 L8,14 L19,14 L19,24"
                                  Stroke="#9DAFFF" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform"/>
                            <TextBlock x:Name="SaveText" Text="Сохранить" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="25" Background="#35415B" Margin="1,0,12,0"/>
                    <Button x:Name="UndoBtn" Style="{StaticResource CommandButton}" Click="Undo_Click"
                            ToolTip="Отменить (Ctrl+Z)" Margin="0,0,8,0" Padding="11,10">
                        <Path Data="M 9,5 L3,11 L9,17 M3,11 L15,11 Q23,11 22,19" Stroke="White" StrokeThickness="2"
                              Stretch="Uniform" Width="18" Height="18" Fill="Transparent"/>
                    </Button>
                    <Button x:Name="RedoBtn" Style="{StaticResource CommandButton}" Click="Redo_Click"
                            ToolTip="Повторить (Ctrl+Y)" Padding="11,10" Margin="0,0,12,0">
                        <Path Data="M 15,5 L21,11 L15,17 M21,11 L9,11 Q1,11 2,19" Stroke="White" StrokeThickness="2"
                              Stretch="Uniform" Width="18" Height="18" Fill="Transparent"/>
                    </Button>
                    <Border Width="1" Height="25" Background="#35415B" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource CommandButton}" Click="Import_Click" Margin="0,0,9,0">
                        <TextBlock x:Name="ImportText" Text="Импорт PNG / JPG"/>
                    </Button>
                    <Button Style="{StaticResource AccentButton}" Click="ExportIco_Click" Margin="0,0,9,0">
                        <TextBlock x:Name="ExportIcoText" Text="Экспорт ICO"/>
                    </Button>
                    <Button Style="{StaticResource CommandButton}" Click="ExportPng_Click">
                        <TextBlock x:Name="ExportPngText" Text="Экспорт PNG"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main workstation -->
        <Grid Grid.Row="2" Margin="13,13,13,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="132"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="315"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource Panel}" Margin="0,0,12,0">
                <StackPanel Margin="9,18,9,10">
                    <TextBlock x:Name="ToolsHeading" Text="ИНСТРУМЕНТЫ" Foreground="#95A2BF" FontSize="10"
                               FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                    <StackPanel x:Name="ToolPanel" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ToolButton}" Tag="Brush" Click="Tool_Click" ToolTip="Кисть">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 4,21 C 11,23 15,19 15,14 L 23,5 L19,1 L10,10 C 7,12 6,15 6,18 Z" Fill="#D3B9FF"
                                      Stretch="Uniform" Width="22" Height="22"/>
                                <TextBlock x:Name="BrushLabel" Text="Кисть" Style="{StaticResource ToolButtonLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Pencil" Click="Tool_Click" ToolTip="Карандаш">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 5,19 L4,24 L10,22 L24,8 L18,2 Z M16,5 L21,10" Stroke="#D3B9FF"
                                      StrokeThickness="2" Fill="Transparent" Stretch="Uniform" Width="22" Height="22"/>
                                <TextBlock x:Name="PencilLabel" Text="Карандаш" Style="{StaticResource ToolButtonLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Eraser" Click="Tool_Click" ToolTip="Ластик">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 2,17 L12,4 L23,14 L13,24 L8,24 Z M8,24 L18,9" Stroke="#F7B9D2"
                                      StrokeThickness="2" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock x:Name="EraserLabel" Text="Ластик" Style="{StaticResource ToolButtonLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Fill" Click="Tool_Click" ToolTip="Заливка">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 5,13 L 13,5 L22,14 L14,22 Z M4,3 L19,18" Stroke="#A4E5D3"
                                      StrokeThickness="2" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock x:Name="FillLabel" Text="Заливка" Style="{StaticResource ToolButtonLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Line" Click="Tool_Click" ToolTip="Линия">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 3,22 L22,3" Stroke="#B6CDFF" StrokeThickness="2.7"
                                      Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock x:Name="LineLabel" Text="Линия" Style="{StaticResource ToolButtonLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Rectangle" Click="Tool_Click" ToolTip="Прямоугольник">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 3,5 L21,5 L21,20 L3,20 Z" Stroke="#B6CDFF" StrokeThickness="2.1"
                                      Width="22" Height="22" Stretch="Uniform" Fill="Transparent"/>
                                <TextBlock x:Name="RectangleLabel" Text="Прямоугольник" Style="{StaticResource ToolButtonLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Ellipse" Click="Tool_Click" ToolTip="Эллипс">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="22" Height="22" Stroke="#B6CDFF" StrokeThickness="2.3"/>
                                <TextBlock x:Name="EllipseLabel" Text="Эллипс" Style="{StaticResource ToolButtonLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ToolButton}" Tag="Eyedropper" Click="Tool_Click" ToolTip="Пипетка">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="M 14,4 L20,10 M16,2 L22,8 L13,17 L10,14 Z M10,14 L5,23 L3,21 L12,12"
                                      Stroke="#F6D5AD" StrokeThickness="2" Fill="Transparent" Width="22" Height="22" Stretch="Uniform"/>
                                <TextBlock x:Name="EyedropperLabel" Text="Пипетка" Style="{StaticResource ToolButtonLabel}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Border Height="1" Background="#33405A" Margin="9,20"/>
                    <TextBlock x:Name="CurrentToolCaption" Text="Кисть" TextAlignment="Center" Foreground="#EAF0FF"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <TextBlock x:Name="ShortcutsHint" Text="B · кисть&#10;E · ластик&#10;G · заливка&#10;I · пипетка"
                               FontSize="11" Foreground="#8190AA" LineHeight="22" TextAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}" Background="#101726" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="65"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="22,15,22,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CanvasHeading" Text="Холст" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CanvasCaption" Text="Прозрачный фон · пиксельный редактор"
                                       Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#202B42" CornerRadius="8" Padding="12,8"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="CanvasSizeText" Text="128 × 128 px" Foreground="#D2D9EE" FontSize="12"/>
                        </Border>
                    </Grid>
                    <Grid Grid.Row="1" Margin="22,12,22,12" ClipToBounds="True">
                        <Border Background="#0A111E" BorderBrush="#253047" BorderThickness="1" CornerRadius="12"/>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="22,18">
                            <Border x:Name="CanvasSurface" Width="512" Height="512" BorderBrush="#727C90"
                                    BorderThickness="1" Background="{StaticResource CheckerBrush}"
                                    MouseLeftButtonDown="Canvas_MouseDown"
                                    MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseUp"
                                    MouseRightButtonDown="Canvas_RightButtonDown">
                                <Grid Background="Transparent">
                                    <Image x:Name="CanvasImage" Stretch="Fill" SnapsToDevicePixels="True"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Grid>
                            </Border>
                        </Viewbox>
                    </Grid>
                    <Grid Grid.Row="2" Margin="22,0,22,0">
                        <TextBlock x:Name="CanvasInstruction" Text="Рисуй мышью · Ctrl+Z — отмена · Ctrl+S — сохранить"
                                   VerticalAlignment="Center" Foreground="#8D9FBD" FontSize="11"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Properties & layers -->
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="20,20,20,15">
                        <TextBlock x:Name="ColorHeading" Text="ЦВЕТ" Foreground="#A5B4D2"
                                   FontSize="11" FontWeight="Bold" Margin="0,0,0,13"/>
                        <!-- Photoshop-style inline color selector, available without opening a dialog. -->
                        <TextBlock x:Name="InlinePickerHeading" Text="ПАЛИТРА ЦВЕТОВ" Foreground="#91A2C5"
                                   FontSize="10" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <local:InlineColorPicker x:Name="InlinePicker" Margin="0,0,0,14"/>
                        <TextBlock x:Name="InlinePickerHint" Text="Слева — яркость и насыщенность, справа — оттенок"
                                   Foreground="#8190AA" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <Border x:Name="ColorPreview" Height="48" Background="#7857E8" CornerRadius="11"
                                Margin="0,0,0,12"/>
                        <Grid Margin="0,0,0,13">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="HexInput" Text="#7857E8" Style="{StaticResource Field}"
                                     VerticalContentAlignment="Center" KeyDown="HexInput_KeyDown"/>
                            <Button Grid.Column="1" Margin="9,0,0,0" Style="{StaticResource AccentButton}"
                                    Click="ApplyHex_Click">
                                <TextBlock x:Name="ApplyHexText" Text="OK"/>
                            </Button>
                        </Grid>
                        <Button Style="{StaticResource CommandButton}" Click="PickColor_Click" Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="M14,4 L20,10 M16,2 L22,8 L13,17 L10,14 Z M10,14 L5,23 L3,21 L12,12"
                                      Stroke="#C8B8FF" StrokeThickness="2" Fill="Transparent" Width="19" Height="19" Stretch="Uniform"/>
                                <TextBlock x:Name="ColorPickerText" Text="Выбрать цвет..." Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <UniformGrid Columns="6" Rows="2" Margin="0,0,0,18">
                            <Button Background="#7857E8" Click="Swatch_Click" Tag="#7857E8" Height="29" Margin="2" ToolTip="#7857E8"/>
                            <Button Background="#F43F5E" Click="Swatch_Click" Tag="#F43F5E" Height="29" Margin="2" ToolTip="#F43F5E"/>
                            <Button Background="#F59E0B" Click="Swatch_Click" Tag="#F59E0B" Height="29" Margin="2" ToolTip="#F59E0B"/>
                            <Button Background="#FDE047" Click="Swatch_Click" Tag="#FDE047" Height="29" Margin="2" ToolTip="#FDE047"/>
                            <Button Background="#10B981" Click="Swatch_Click" Tag="#10B981" Height="29" Margin="2" ToolTip="#10B981"/>
                            <Button Background="#38BDF8" Click="Swatch_Click" Tag="#38BDF8" Height="29" Margin="2" ToolTip="#38BDF8"/>
                            <Button Background="#FFFFFF" Click="Swatch_Click" Tag="#FFFFFF" Height="29" Margin="2" ToolTip="#FFFFFF"/>
                            <Button Background="#A7B2CB" Click="Swatch_Click" Tag="#A7B2CB" Height="29" Margin="2" ToolTip="#A7B2CB"/>
                            <Button Background="#111827" Click="Swatch_Click" Tag="#111827" Height="29" Margin="2" ToolTip="#111827"/>
                            <Button Background="#3B82F6" Click="Swatch_Click" Tag="#3B82F6" Height="29" Margin="2" ToolTip="#3B82F6"/>
                            <Button Background="#D946EF" Click="Swatch_Click" Tag="#D946EF" Height="29" Margin="2" ToolTip="#D946EF"/>
                            <Button Background="#FB923C" Click="Swatch_Click" Tag="#FB923C" Height="29" Margin="2" ToolTip="#FB923C"/>
                        </UniformGrid>
                        <!-- Optional saved-color collection retained from v0.2. -->
                        <Expander x:Name="SavedColorsExpander" Header="Сохранённые цвета" IsExpanded="False"
                                  Foreground="#CBD5F1" Margin="0,0,0,16">
                            <StackPanel Margin="0,11,0,0">

                        <Border Height="1" Background="#33405A" Margin="0,1,0,14"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PaletteHeading" Text="МОЯ ПАЛИТРА"
                                       Foreground="#A5B4D2" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="PaletteCountText" Grid.Column="1" Text="0 / 36"
                                       FontSize="11" Foreground="#9CB0D5" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Background="#10192B" BorderBrush="#34425D" BorderThickness="1"
                                CornerRadius="9" Padding="8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="PaletteEmptyText" Text="Добавь свой первый цвет"
                                           Foreground="#8495B5" FontSize="11" TextAlignment="Center"
                                           Margin="2,9"/>
                                <WrapPanel x:Name="UserPalettePanel" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource AccentButton}"
                                    x:Name="PaletteAddButton" Click="AddPaletteColor_Click">
                                <TextBlock x:Name="PaletteAddText" Text="+ Добавить"/>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource CommandButton}"
                                    x:Name="PaletteRemoveButton" Click="RemovePaletteColor_Click"
                                    IsEnabled="False">
                                <TextBlock x:Name="PaletteRemoveText" Text="− Удалить"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="PaletteHintText"
                                   Text="Выбери цвет нажатием. Он сохранится вместе с проектом."
                                   Foreground="#7789A8" FontSize="11" TextWrapping="Wrap"
                                   Margin="0,0,0,15"/>
                            </StackPanel>
                        </Expander>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="BrushSizeHeading" Text="Размер кисти" Foreground="#BEC8DE" VerticalAlignment="Center" FontSize="12"/>
                            <TextBlock x:Name="BrushSizeText" Grid.Column="1" Text="6 px" FontSize="12" Foreground="#D9DEEF"/>
                        </Grid>
                        <Slider x:Name="BrushSizeSlider" Minimum="1" Maximum="32" Value="6" SmallChange="1"
                                TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,0,0,17"
                                ValueChanged="BrushSizeSlider_ValueChanged"/>
                        <Border Height="1" Background="#344059" Margin="0,0,0,17"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="LayersHeading" Text="СЛОИ" Foreground="#A5B4D2" FontSize="11" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="LayerCountText" Grid.Column="1" Text="1" Foreground="#8191B3" FontSize="11"/>
                        </Grid>
                        <ListBox x:Name="LayerList" Height="164" Margin="0,0,0,11"
                                 Background="#10192B" Foreground="#EDF0FF" BorderBrush="#35435E"
                                 BorderThickness="1" SelectionChanged="LayerList_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="39" Margin="2,0,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                  ToolTip="Слой виден" IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
                                        <Border Grid.Column="1" Width="17" Height="17" BorderBrush="#8D9EBD"
                                                BorderThickness="1" Background="#4C5D7D" CornerRadius="3"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                                   Foreground="#EDF0FF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,0,0,11">
                            <Button Style="{StaticResource SmallButton}" Click="AddLayer_Click" ToolTip="Добавить слой" Content="+"/>
                            <Button Style="{StaticResource SmallButton}" Click="DeleteLayer_Click" ToolTip="Удалить слой" Content="−"/>
                            <Button Style="{StaticResource SmallButton}" Click="MoveLayerUp_Click" ToolTip="Выше" Content="↑"/>
                            <Button Style="{StaticResource SmallButton}" Click="MoveLayerDown_Click" ToolTip="Ниже" Content="↓"/>
                        </WrapPanel>
                        <TextBlock x:Name="RenameHeading" Text="Имя слоя" Foreground="#A5B4D2" FontSize="11" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="LayerNameInput" Style="{StaticResource Field}" Text="Layer 1"/>
                            <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource CommandButton}" Click="RenameLayer_Click">
                                <TextBlock x:Name="RenameText" Text="ОК"/>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="LayersHint" Text="Верхний слой перекрывает нижние."
                                   Foreground="#7283A2" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="#101827" BorderBrush="#2D3C57" BorderThickness="0,1,0,0">
            <Grid Margin="19,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusMessage" Text="Готово к работе" Foreground="#99DCC6" VerticalAlignment="Center" FontSize="11"/>
                <TextBlock x:Name="PositionText" Grid.Column="1" Text="X: —  Y: —" Foreground="#8F9FBD"
                           VerticalAlignment="Center" FontSize="11" Margin="0,0,25,0"/>
                <TextBlock x:Name="DimensionsText" Grid.Column="2" Text="128 × 128" Foreground="#C7D0E4"
                           VerticalAlignment="Center" FontSize="11"/>
            </Grid>
        </Border>
    </Grid>
</Window>
